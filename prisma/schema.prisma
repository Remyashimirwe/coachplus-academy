generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Program {
  id        Int       @id @default(autoincrement())
  title     String
  level     String
  text      String
  image     String?
  sortOrder Int       @default(0)
  subjects  Subject[]
}

model Subject {
  id        Int     @id @default(autoincrement())
  name      String
  image     String?
  programId Int
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id        Int     @id @default(autoincrement())
  name      String
  image     String?
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Request {
  id         Int      @id @default(autoincrement())
  parentName String
  email      String
  phone      String   @default("")
  grade      String   @default("")
  subjects   String   @default("")
  details    String   @default("")
  status     String   @default("new")
  createdAt  DateTime @default(now())
  location   String   @default("")
  phone2     String   @default("")
  cell       String   @default("")
  district   String   @default("")
  province   String   @default("")
  sector     String   @default("")
  village    String   @default("")
  idPassport String   @default("")
  country    String   @default("")
}

model TeacherApplication {
  id                      Int      @id @default(autoincrement())
  fullName                String
  email                   String
  phone                   String
  country                 String   @default("")
  province                String   @default("")
  district                String   @default("")
  sector                  String   @default("")
  cell                    String   @default("")
  village                 String   @default("")
  linkedin                String?
  instagram               String?
  youtube                 String?
  otherSocial             String?
  photoUrl                String?
  educationLevel          String   @default("")
  fieldOfStudy            String   @default("")
  institution             String   @default("")
  graduationYear          String   @default("")
  academicCertificatesUrl String?
  experienceYears         String   @default("")
  subjects                String
  grades                  String   @default("")
  previousOrg             String?
  previousPos             String?
  expDescription          String   @default("")
  methods                 String   @default("")
  difficultStudents       String   @default("")
  engagement              String   @default("")
  techTools               String?
  teachOnline             String   @default("")
  employmentType          String   @default("")
  availableDays           String   @default("")
  availableHours          String   @default("")
  startDate               String   @default("")
  resumeUrl               String?
  coverLetterUrl          String?
  otherCertificatesUrl    String?
  licenseUrl              String?
  portfolioUrl            String?
  whyTeach                String   @default("")
  whySelect               String   @default("")
  contribution            String   @default("")
  agreedToTerms           Boolean  @default(false)
  status                  String   @default("pending")
  createdAt               DateTime @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

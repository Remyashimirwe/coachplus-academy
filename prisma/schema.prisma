generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id                   Int          @id @default(autoincrement())
  email                String       @unique
  passwordHash         String?      // Nullable for first-time users
  name                 String
  role                 Role
  isFirstLogin         Boolean      @default(true)
  inviteToken          String?      @unique
  inviteTokenExpiresAt DateTime?
  createdAt            DateTime     @default(now())
  
  // Relations
  teacherProfile  Teacher?     @relation("UserToTeacher")
  studentProfile  Student?     @relation("UserToStudent")
}

model Teacher {
  id          Int          @id @default(autoincrement())
  userId      Int          @unique
  user        User         @relation("UserToTeacher", fields: [userId], references: [id])
  phone       String       @default("")
  branch      String       @default("") // Location branch, e.g. Kigali-Remera
  subjects    String       @default("") // Courses/subjects the teacher can teach
  students    Student[]    @relation("TeacherStudents")
  attendances Attendance[]
  reports     Report[]
}

model Student {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  user           User         @relation("UserToStudent", fields: [userId], references: [id])
  teacherId      Int?
  teacher        Teacher?     @relation("TeacherStudents", fields: [teacherId], references: [id])
  phone          String       @default("")
  branch         String       @default("") // Location branch, e.g. Kigali-Remera
  subjects       String       @default("") // Courses/topics the student wants to learn
  attendances    Attendance[]
  reports        Report[]
  parentRequest  Request?     @relation("RequestStudent")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  status    String   // "PRESENT", "ABSENT", "LATE"
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  remarks   String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model Report {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  teacherId  Int?
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
  category   String   @default("Other")
  message    String
  status     String   @default("new") // "new", "reviewed", "resolved"
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Program {
  id        Int       @id @default(autoincrement())
  title     String
  level     String
  text      String
  image     String?
  sortOrder Int       @default(0)
  subjects  Subject[]
}

model Subject {
  id        Int     @id @default(autoincrement())
  name      String
  image     String?
  sortOrder Int     @default(0)
  programId Int
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id        Int     @id @default(autoincrement())
  name      String
  image     String?
  sortOrder Int     @default(0)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Request {
  id                Int      @id @default(autoincrement())
  parentName        String
  email             String
  phone             String   @default("")
  grade             String   @default("")
  subjects          String   @default("")
  details           String   @default("")
  status            String   @default("new")
  createdAt         DateTime @default(now())
  location          String   @default("")
  branch            String   @default("") // Location branch, e.g. Kigali-Remera
  phone2            String   @default("")
  cell              String   @default("")
  district          String   @default("")
  province          String   @default("")
  sector            String   @default("")
  village           String   @default("")
  idPassport        String   @default("")
  country           String   @default("")
  studentId         Int?     @unique
  student           Student? @relation("RequestStudent", fields: [studentId], references: [id])
}

model TeacherApplication {
  id                      Int      @id @default(autoincrement())
  fullName                String
  email                   String
  phone                   String
  branch                  String   @default("") // Location branch, e.g. Kigali-Remera
  country                 String   @default("")
  province                String   @default("")
  district                String   @default("")
  sector                  String   @default("")
  cell                    String   @default("")
  village                 String   @default("")
  linkedin                String?
  instagram               String?
  youtube                 String?
  otherSocial             String?
  educationLevel          String   @default("")
  fieldOfStudy            String   @default("")
  institution             String   @default("")
  graduationYear          String   @default("")
  experienceYears         String   @default("")
  subjects                String
  grades                  String   @default("")
  previousOrg             String?
  previousPos             String?
  expDescription          String   @default("")
  methods                 String   @default("")
  difficultStudents       String   @default("")
  engagement              String   @default("")
  techTools               String?
  teachOnline             String   @default("")
  employmentType          String   @default("")
  availableDays           String   @default("")
  availableHours          String   @default("")
  startDate               String   @default("")
  portfolioUrl            String?
  whyTeach                String   @default("")
  whySelect               String   @default("")
  contribution            String   @default("")
  agreedToTerms           Boolean  @default(false)
  status                  String   @default("pending")
  createdAt               DateTime @default(now())

  documents TeacherApplicationDocument[]
}

model TeacherApplicationDocument {
  id            Int                @id @default(autoincrement())
  applicationId Int
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String   // "photo" | "resume" | "coverLetter" | "academicCertificates" | "otherCertificates" | "license"
  fileName      String
  mimeType      String
  url           String   // Cloudinary secure URL
  publicId      String   @default("") // Cloudinary public id (for future deletion/management)
  createdAt     DateTime @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  passwordHash         String? // Nullable for first-time users
  name                 String
  image                String? // Profile picture (URL or data URL)
  role                 Role
  isFirstLogin         Boolean   @default(true)
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now())

  // Relations
  teacherProfile Teacher? @relation("UserToTeacher")
  studentProfile Student? @relation("UserToStudent")
  notifications  Notification[]
  deviceTokens   DeviceToken[]
}

model Teacher {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @unique
  user               User                @relation("UserToTeacher", fields: [userId], references: [id])
  phone              String              @default("")
  country            String              @default("")
  city               String              @default("")
  village            String              @default("")
  cell               String              @default("")
  subjects           String              @default("")
  availableDays      String              @default("") // Comma-separated: "Monday, Wednesday, Friday"
  availableHours     String              @default("") // e.g. "14:00 - 20:00"
  isFired            Boolean             @default(false)
  firedAt            DateTime?
  fireMessage        String?
  students           Student[]           @relation("TeacherStudents")
  attendances        Attendance[]
  teacherAttendances TeacherAttendance[]
  reports            Report[]
  developmentReports DevelopmentReport[]
  ratings            TeacherRating[]
}

model Student {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  user          User         @relation("UserToStudent", fields: [userId], references: [id])
  teacherId     Int?
  teacher       Teacher?     @relation("TeacherStudents", fields: [teacherId], references: [id])
  phone         String       @default("")
  subjects      String       @default("") // Courses/topics the student wants to learn
  program       String       @default("") // Program/category the student enrolled in
  learningMode  String       @default("") // Home Coaching | Online Coaching | Coaching Center
  preferredDays String       @default("") // Comma-separated preferred days, e.g. "Monday, Wednesday"
  preferredTime String       @default("") // Day-time slots, e.g. "Monday: 08:00 - 10:00, Wednesday: 09:00 - 11:00"
  startDate     String       @default("") // Preferred start date
  attendances      Attendance[]
  reports          Report[]
  parentRequest    Request?              @relation("RequestStudent")
  selfAttendances  StudentAttendance[]
  developmentReports DevelopmentReport[]
  teacherRatings   TeacherRating[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  status    String // "PRESENT", "ABSENT"
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  remarks   String?
  timeUsed  String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model TeacherAttendance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  status    String // "PRESENT", "ABSENT"
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  remarks   String?
  timeUsed  String?
  createdAt DateTime @default(now())

  @@unique([teacherId, date])
}

model StudentAttendance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  status    String // "PRESENT", "ABSENT"
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  remarks   String?
  timeUsed  String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info") // "info" | "success" | "warning"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String   @default("android") // "android" | "ios" | "web"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Report {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  teacherId  Int?
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
  category   String   @default("Other")
  message    String
  status     String   @default("new") // "new", "reviewed", "resolved"
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DevelopmentReport {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  teacherId  Int
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  category   String   @default("General") // "General", "Progress", "Behavior", "Attendance", "Other"
  title      String
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeacherRating {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  rating    Int      // 1-5 stars
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, teacherId])
}

model Program {
  id                Int       @id @default(autoincrement())
  title             String
  level             String
  text              String
  image             String?
  sortOrder         Int       @default(0)
  featuredInHero    Boolean   @default(false) // Shown in the homepage Hero slideshow when true
  showOnTeacherForm Boolean   @default(true) // Selectable on the Become a Teacher application form
  subjects          Subject[]
}

model Subject {
  id                Int     @id @default(autoincrement())
  name              String
  image             String?
  sortOrder         Int     @default(0)
  showOnTeacherForm Boolean @default(true) // Selectable on the Become a Teacher application form
  programId         Int
  program           Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  topics            Topic[]
}

model Topic {
  id                Int     @id @default(autoincrement())
  name              String
  image             String?
  sortOrder         Int     @default(0)
  showOnTeacherForm Boolean @default(true)
  subjectId         Int
  subject           Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Request {
  id            Int      @id @default(autoincrement())
  parentName    String
  email         String
  phone         String   @default("")
  grade         String   @default("")
  subjects      String   @default("")
  details       String   @default("")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  location      String   @default("")
  phone2        String   @default("")
  cell          String   @default("")
  district      String   @default("")
  province      String   @default("")
  sector        String   @default("")
  village       String   @default("")
  idPassport    String   @default("")
  country       String   @default("")
  programTitle  String   @default("") // Program/category the student is requesting
  learningMode  String   @default("") // Home Coaching | Online Coaching | Coaching Center
  preferredDays String   @default("") // Comma-separated preferred days, e.g. "Monday, Wednesday"
  preferredTime String   @default("") // Day-time slots, e.g. "Monday: 08:00 - 10:00, Wednesday: 09:00 - 11:00"
  startDate     String   @default("") // Preferred start date
  studentId     Int?     @unique
  student       Student? @relation("RequestStudent", fields: [studentId], references: [id])
}

model TeacherApplication {
  id                Int      @id @default(autoincrement())
  fullName          String
  email             String
  phone             String
  country           String   @default("")
  province          String   @default("")
  district          String   @default("")
  sector            String   @default("")
  cell              String   @default("")
  village           String   @default("")
  linkedin          String?
  instagram         String?
  youtube           String?
  otherSocial       String?
  educationLevel    String   @default("")
  fieldOfStudy      String   @default("")
  institution       String   @default("")
  graduationYear    String   @default("")
  experienceYears   String   @default("")
  subjects          String
  grades            String   @default("")
  previousOrg       String?
  previousPos       String?
  expDescription    String   @default("")
  methods           String   @default("")
  difficultStudents String   @default("")
  engagement        String   @default("")
  techTools         String?
  teachOnline       String   @default("")
  onlinePlatforms   String   @default("")
  employmentType    String   @default("")
  availableDays     String   @default("")
  availableHours    String   @default("")
  startDate         String   @default("")
  portfolioUrl      String?
  whyTeach          String   @default("")
  whySelect         String   @default("")
  contribution      String   @default("")
  agreedToTerms     Boolean  @default(false)
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  documents TeacherApplicationDocument[]
}

model TeacherApplicationDocument {
  id            Int                @id @default(autoincrement())
  applicationId Int
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String // "photo" | "resume" | "coverLetter" | "academicCertificates" | "otherCertificates" | "license"
  fileName      String
  mimeType      String
  url           String // Cloudinary secure URL
  publicId      String             @default("") // Cloudinary public id (for future deletion/management)
  createdAt     DateTime           @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

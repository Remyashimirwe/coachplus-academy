// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  name          String
  createdAt     DateTime @default(now())
}

model Program {
  id        Int       @id @default(autoincrement())
  title     String
  level     String
  text      String
  image     String?
  sortOrder Int       @default(0)
  subjects  Subject[]
}

model Subject {
  id        Int     @id @default(autoincrement())
  name      String
  image     String?
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId Int
  topics    Topic[]
}

model Topic {
  id        Int     @id @default(autoincrement())
  name      String
  image     String?
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
}

model Request {
  id         Int      @id @default(autoincrement())
  parentName String
  email      String
  phone      String   @default("")
  phone2     String   @default("")
  country    String   @default("")
  location   String   @default("")
  province   String   @default("")
  district   String   @default("")
  sector     String   @default("")
  cell       String   @default("")
  village    String   @default("")
  idPassport String   @default("")
  grade      String   @default("")
  subjects   String   @default("")
  details    String   @default("")
  status     String   @default("new")
  createdAt  DateTime @default(now())
}

model TeacherApplication {
  id           Int      @id @default(autoincrement())
  // 1. Personal Information
  fullName     String
  email        String
  phone        String
  country      String   @default("")
  city         String   @default("")
  location     String   @default("")
  linkedin     String?
  instagram    String?
  youtube      String?
  otherSocial  String?
  photoUrl     String?

  // 2. Education
  educationLevel String  @default("")
  fieldOfStudy   String  @default("")
  institution    String  @default("")
  graduationYear String  @default("")
  academicCertificatesUrl String?

  // 3. Teaching Experience
  experienceYears String @default("")
  subjects      String
  grades        String   @default("")
  previousOrg   String?
  previousPos   String?
  expDescription String  @default("")

  // 4. Teaching Skills
  methods       String   @default("")
  difficultStudents String @default("")
  engagement    String   @default("")
  techTools     String?
  teachOnline   String   @default("")

  // 5. Availability
  employmentType String  @default("")
  availableDays String   @default("")
  availableHours String  @default("")
  startDate     String   @default("")

  // 6. Application Documents
  resumeUrl     String?
  coverLetterUrl String?
  otherCertificatesUrl String?
  licenseUrl    String?
  portfolioUrl  String?

  // 7. Final Questions
  whyTeach      String   @default("")
  whySelect     String   @default("")
  contribution  String   @default("")

  // 8. Declaration
  agreedToTerms Boolean  @default(false)

  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
